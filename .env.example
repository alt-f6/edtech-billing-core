# Local Postgres from docker-compose.yml. Tests DROP and recreate the public
# schema of this database on every run: never point it at real data.
DATABASE_URL=postgres://app:app@127.0.0.1:54329/billing_test

# Server-side key for hashing client IPs (HMAC). Use a long random value in production.
IP_HASH_KEY=dev-only-change-me
